            "body": {
              "mode": "raw",
              "raw": "{\n  \"agentId\": \"{{agentId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/assign", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "{{ticketId}}", "assign"] }
          }
        },
        {
          "name": "Manager Auto-Assigns Ticket (Module 3)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/auto-assign", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "{{ticketId}}", "auto-assign"] }
          }
        },
        {
          "name": "Agent Updates Status to In Progress (Module 4)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{agentToken}}" }
