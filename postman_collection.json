    {
      "name": "05 - SLA Breach Tracking (Module 6)",
      "item": [
        {
          "name": "Scan & Flag SLA Breached Tickets",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/tickets/breaches/check", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "breaches", "check"] }
          }
        },
        {
          "name": "Query Breached Tickets Filter",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/tickets?breached=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets"],
              "query": [{ "key": "breached", "value": "true" }]
            }
          }
        }
      ]
