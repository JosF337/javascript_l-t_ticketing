    {
      "name": "02 - Category & SLA Management (Module 10)",
      "item": [
        {
          "name": "Create SLA Rule (Manager)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
