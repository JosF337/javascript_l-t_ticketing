          "name": "Customer Views Comments (Internal Notes Hidden)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/comments", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "{{ticketId}}", "comments"] }
