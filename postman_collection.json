          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{managerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"Software\",\n  \"priority\": \"Urgent\",\n  \"resolutionHours\": 4\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/sla", "host": ["{{baseUrl}}"], "path": ["api", "sla"] }
          }
        },
        {
          "name": "List All SLA Rules",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/sla", "host": ["{{baseUrl}}"], "path": ["api", "sla"] }
          }
        },
        {
