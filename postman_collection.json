        {
          "name": "Agent Views Comments (All Notes Visible)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{agentToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/comments", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "{{ticketId}}", "comments"] }
          }
        }
