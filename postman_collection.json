    {
      "name": "08 - Instructor Test Failure Scenarios",
      "item": [
        {
          "name": "Scenario 2: Validation Failure - Missing Description (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Missing description\",\n  \"category\": \"Software\",\n  \"priority\": \"Low\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/tickets", "host": ["{{baseUrl}}"], "path": ["api", "tickets"] }
          }
        },
        {
          "name": "Scenario 3: Authentication Failure - No Token (401)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/tickets", "host": ["{{baseUrl}}"], "path": ["api", "tickets"] }
          }
        },
        {
          "name": "Scenario 4: Authorization Failure - Customer Calls Manager Route (403)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/manager/reports/sla", "host": ["{{baseUrl}}"], "path": ["api", "manager", "reports", "sla"] }
          }
        },
        {
          "name": "Scenario 5A: Business-Rule Conflict - Illegal Transition Open to Closed (409)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{managerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Closed\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "{{ticketId}}", "status"] }
          }
        },
        {
          "name": "Scenario 5B: Business-Rule Conflict - Duplicate Rating on Closed Ticket (409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticketId\": \"{{ticketId}}\",\n  \"score\": 4,\n  \"comment\": \"Attempting duplicate rating\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/ratings", "host": ["{{baseUrl}}"], "path": ["api", "ratings"] }
          }
        },
        {
          "name": "Scenario 6: Not-Found Case - Invalid Ticket ID (404)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/tickets/65f1a2b3c4d5e6f7a8b9c0d1", "host": ["{{baseUrl}}"], "path": ["api", "tickets", "65f1a2b3c4d5e6f7a8b9c0d1"] }
